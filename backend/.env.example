HOST=0.0.0.0
PORT=5002
DEBUG=True

MYSQL_HOST=
# MYSQL_HOST=localhost
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=


ENABLE_AUTH=true

# JWT密钥（必须设置，用于签名token）
JWT_SECRET_KEY=


# ==================== 预警调度配置 ====================
# 防抖时间（秒）：同一规则在此时间内不重复预警（单位是秒）
ALERT_DEBOUNCE_SECONDS=300

# APScheduler 配置
# 同一任务最多并发实例数
ALERT_SCHEDULER_MAX_INSTANCES=1

# 错过的任务是否合并执行
ALERT_SCHEDULER_COALESCE=true

# 错过执行的宽限时间（秒）
ALERT_SCHEDULER_MISFIRE_GRACE_TIME=60

# 线程池大小：最多同时执行多少个不同规则的检查任务
ALERT_SCHEDULER_THREAD_POOL_SIZE=10


# 钉钉自定义机器人配置
DINGTALK_ACCESS_TOKEN=
DINGTALK_SECRET=

# ==================== 心跳 WebSocket 监控配置 ====================
HEARTBEAT_WS_PORT=8001
# 心跳超时时间（秒），超过此时间无心跳则报警
HEARTBEAT_TIMEOUT_SECONDS=300
# 超时检查间隔（秒）
HEARTBEAT_CHECK_INTERVAL_SECONDS=30
# 报警冷却时间（秒），同一次断线不重复报警
HEARTBEAT_ALERT_COOLDOWN_SECONDS=3600

#养殖池实时监控SSE轮询间隔（秒）
SSE_POLL_INTERVAL=10