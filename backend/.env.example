HOST=0.0.0.0
PORT=5002
DEBUG=True

MYSQL_HOST=
# MYSQL_HOST=localhost
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=


ENABLE_AUTH=true

# JWT密钥（必须设置，用于签名token）
JWT_SECRET_KEY=


# ==================== 预警调度配置 ====================
# 防抖时间（秒）：同一规则在此时间内不重复预警（单位是秒）
ALERT_DEBOUNCE_SECONDS=300

# APScheduler 配置
# 同一任务最多并发实例数
ALERT_SCHEDULER_MAX_INSTANCES=1

# 错过的任务是否合并执行
ALERT_SCHEDULER_COALESCE=true

# 错过执行的宽限时间（秒）
ALERT_SCHEDULER_MISFIRE_GRACE_TIME=60

# 线程池大小：最多同时执行多少个不同规则的检查任务
ALERT_SCHEDULER_THREAD_POOL_SIZE=10


# 钉钉自定义机器人配置
DINGTALK_ACCESS_TOKEN=
DINGTALK_SECRET=

# ==================== 心跳 WebSocket 监控配置 ====================
HEARTBEAT_WS_PORT=8001
# 心跳超时时间（秒），超过此时间无心跳则报警
HEARTBEAT_TIMEOUT_SECONDS=300
# 超时检查间隔（秒）
HEARTBEAT_CHECK_INTERVAL_SECONDS=30
# 报警冷却时间（秒），同一次断线不重复报警
HEARTBEAT_ALERT_COOLDOWN_SECONDS=3600

#养殖池实时监控SSE轮询间隔（秒）
SSE_POLL_INTERVAL=10

# ==================== 预测配置 ====================
# 最近多少条历史数据参与预测（当前方案固定按最近5条）
PREDICTION_HISTORY_LIMIT=5
# 预测目标时间间隔（分钟），例如 10 表示预测下一个 10 分钟时间点
PREDICTION_INTERVAL_MINUTES=10
# 是否启用大模型预测
PREDICTION_ENABLE_LLM=true
# 无大模型或大模型调用失败时，是否启用简单规则兜底预测
PREDICTION_FALLBACK_ENABLED=true
# 预测模型名称，可单独覆盖通用 OPENAI_MODEL
PREDICTION_MODEL_NAME=anthropic/claude-sonnet-4.5
# 大模型单次预测允许输出的最大 token 数
PREDICTION_LLM_MAX_TOKENS=1200
# 后台异步预测线程数，避免首屏请求被预测阻塞
PREDICTION_ASYNC_THREADS=2

# ==================== OpenAI / LLM 配置 ====================
# 大模型 API 密钥（必填）
OPENAI_API_KEY=
# 默认模型名称（项目内其他后续 AI 能力也可复用）
OPENAI_MODEL=anthropic/claude-sonnet-4.5
# 模型温度，越高越发散，预测场景建议 0.2~0.7
OPENAI_TEMPERATURE=0.7
# OpenAI 兼容接口地址；OpenRouter 示例为 https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# 单次大模型请求超时时间（秒）
OPENAI_TIMEOUT=60

# ==================== 天气缓存配置 ====================
# OpenWeatherMap API 密钥（用于定时拉取天气 forecast）
OPENWEATHER_API_KEY=
# 后端天气服务优先读取 WEATHER_API_KEY，未设置时回退到 OPENWEATHER_API_KEY
WEATHER_API_KEY=
# 未来天气 forecast 接口地址
WEATHER_BASE_URL=https://api.openweathermap.org/data/2.5/forecast
# 默认地点，池塘未配置 location 时使用
WEATHER_DEFAULT_LOCATION=Tsukuba
# 天气返回语言
WEATHER_LANG=zh_cn
# 每隔多少小时更新一次天气缓存
WEATHER_UPDATE_INTERVAL_HOURS=3
# 天气缓存有效期（小时）
WEATHER_CACHE_TTL_HOURS=4

# ==================== MQTT 设备控制配置 ====================
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_USER=aqua_device
MQTT_PASSWORD=Aqua2026!

# ==================== 设备连接监控配置 ====================
# MAC设备探测间隔（秒）
DEVICE_MQTT_CHECK_INTERVAL=300
# 超时判定（秒）— 超过此时间无回复，报警+禁用
DEVICE_MQTT_TIMEOUT=600
# 发探测后等待设备回复时间（秒）
DEVICE_MQTT_PROBE_WAIT=20
# API设备(feeder)探测间隔（秒）
DEVICE_API_CHECK_INTERVAL=600
# API设备单次连接超时（秒）
DEVICE_API_CONNECT_TIMEOUT=20
# API设备离线判定/报警阈值（秒）
DEVICE_API_OFFLINE_TIMEOUT=600
# 报警冷却（秒）— 设备恢复后再次断开，间隔内不重复报警
DEVICE_ALERT_COOLDOWN=3600