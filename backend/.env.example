HOST=0.0.0.0
PORT=5002
DEBUG=True

MYSQL_HOST=
# MYSQL_HOST=localhost
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=


ENABLE_AUTH=true

# JWT密钥（必须设置，用于签名token）
JWT_SECRET_KEY=

# 钉钉自定义机器人配置
DINGTALK_ACCESS_TOKEN=
DINGTALK_SECRET=

# ==================== 心跳 WebSocket 监控配置 ====================
HEARTBEAT_WS_PORT=8001
# 心跳超时时间（秒），超过此时间无心跳则报警
HEARTBEAT_TIMEOUT_SECONDS=300
# 超时检查间隔（秒）
HEARTBEAT_CHECK_INTERVAL_SECONDS=30
# 报警冷却时间（秒），同一次断线不重复报警
HEARTBEAT_ALERT_COOLDOWN_SECONDS=3600
# 钉钉报警@的手机号（逗号分隔）
DINGTALK_ALERT_AT_MOBILES=